# --------------------------------------------------------------------------
# CRM SaaS MVP — Production & Development Environment Template
# --------------------------------------------------------------------------
# Copy this file to .env and populate with your environment-specific values.
# NEVER commit the actual .env file or credentials to source control.

APP_NAME="Apex Dynamics CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://your-crm-frontend.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database Configuration (MySQL 8 Production Target)
DB_CONNECTION=mysql
DB_HOST=your-production-db-host.com
DB_PORT=3306
DB_DATABASE=crm_production
DB_USERNAME=crm_db_user
DB_PASSWORD=your_strong_production_password

# For zero-setup local SQLite fallback:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Session Configuration (Database-Backed)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Laravel Sanctum (Only needed if cookie-based SPA auth is used; leave empty for Bearer tokens)
SANCTUM_STATEFUL_DOMAINS=

# Broadcast & Storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue & Cache (Database-Backed)
QUEUE_CONNECTION=database
CACHE_STORE=database

# Logging (Use 'error' or 'warning' in production)
LOG_CHANNEL=stack
LOG_LEVEL=error
